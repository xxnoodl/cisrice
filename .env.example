POSTGRES_PASSWORD=change-this-operator-password
APP_DATABASE_PASSWORD=change-this-runtime-password-at-least-24-characters
MIGRATION_DATABASE_URL=postgresql+psycopg://cisrice:change-this-operator-password@postgres:5432/cisrice
DATABASE_URL=postgresql+psycopg://cisrice_app:change-this-runtime-password-at-least-24-characters@postgres:5432/cisrice
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data
# Media storage limits (bytes); downloads/validation initially use one shared slot.
STORAGE_QUOTA_BYTES=21474836480
MINIMUM_FREE_BYTES=536870912
MAX_MEDIA_BYTES=536870912
STAGING_RETENTION_HOURS=24
# Zero preserves quarantined invalid media; cleanup is operator-only and dry-run by default.
QUARANTINE_RETENTION_DAYS=0
