    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
